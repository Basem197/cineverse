# ============================================================
# CineVerse — Root .gitignore
# ============================================================

# ---------- Environment & Secrets ----------
.env
.env.local
.env.*.local
*.env
!.env.example

# ---------- Dependencies ----------
node_modules/
vendor/
composer.lock

# ---------- Logs ----------
*.log
logs/
api/storage/logs/*.log

# ---------- Cache ----------
api/storage/cache/*
!api/storage/cache/.gitkeep

# ---------- OS Files ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- IDE ----------
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ---------- Build / Dist ----------
dist/
build/

# ---------- Backups ----------
*.bak
*.backup
*.sql.gz
backups/

# ---------- Upload Staging ----------
upload/

# ---------- ZIPs (local artifacts) ----------
*.zip

# ---------- Test Coverage ----------
coverage/

# ---------- Sensitive Debug Files ----------
test-env.php
debug.php
debug-*.php