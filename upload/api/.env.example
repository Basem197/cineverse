# ============================================
# CineVerse API — Environment Variables
# ============================================
# انسخ هذا الملف إلى .env وعدّل القيم
# NEVER commit the real .env file
# ============================================

# ---------- Application ----------
APP_NAME="CineVerse"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/cineverse/api/public
APP_TIMEZONE=UTC

# ---------- Database ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cineverse
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ---------- TMDB API ----------
# Get yours from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=
TMDB_API_BASE=https://api.themoviedb.org/3
TMDB_IMAGE_BASE=https://image.tmdb.org/t/p
TMDB_LANGUAGE=en-US
TMDB_TIMEOUT=10

# ---------- Cache ----------
CACHE_ENABLED=true
CACHE_TTL=86400
CACHE_PATH=storage/cache

# ---------- CORS ----------
# Frontend URL(s). Comma-separated. Use * only for local dev.
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost

# ---------- Security ----------
SESSION_LIFETIME=86400
PASSWORD_MIN_LENGTH=8
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60