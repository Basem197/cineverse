# ============================================================
# CineVerse API — Root Protection
# Deny direct access to everything except public/
# ============================================================

# Disable directory listing
Options -Indexes

# Deny access to sensitive files and directories
<FilesMatch "\.(env|sql|md|log|ini|bak|json)$">
    Require all denied
</FilesMatch>

# Deny access to specific directories
RedirectMatch 403 ^/(app|storage|database|tests)/.*$
RedirectMatch 403 ^/\.env.*$
RedirectMatch 403 ^/\.git.*$